# AI Flight Planner — Environment Variables
# Copy to .env and adjust to your setup

# =============================================================================
# Database
# =============================================================================

# AIRAC cycles directory (relative to project root or absolute)
DATA_DIR=data/cycles

# Default AIRAC cycle to load at startup (e.g., "2604")
DB_CYCLE=2604

# (Legacy) Direct DB path override — if set and the file exists, this takes
# precedence over the cycle-based path resolution. Useful for single-DB setups.
# DB_PATH=/path/to/little_navmap_navigraph.sqlite


# =============================================================================
# LLM Configuration (defaults; can be overridden from frontend settings panel)
# =============================================================================

LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b-agent
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30.0


# =============================================================================
# Server
# =============================================================================

HOST=0.0.0.0
PORT=8000


# =============================================================================
# Route Search
# =============================================================================

DEFAULT_K=5
MAX_K=20
AIRPORT_CONNECTOR_RADIUS_KM=300.0
AIRPORT_CONNECTOR_TOP_N=10
